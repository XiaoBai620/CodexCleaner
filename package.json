{
  "name": "codex-cleaner",
  "version": "2.2.0",
  "description": "A local Windows tool for reviewing and deleting recognized Codex chats and memories.",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node server.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test test/cleaner.test.cjs test/server.test.cjs test/ui.test.cjs",
    "package": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  }
}
